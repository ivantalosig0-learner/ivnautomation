    {
      "id": "94e7dbfb-84d3-4b96-afb1-c66cded647d9",
      "name": "Build Chat Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body || {};\nconst rawMessage = String(body.message || '').trim().slice(0, 600);\nconst rawHistory = Array.isArray(body.history) ? body.history : [];\n\nconst history = rawHistory\n  .filter((m) => m && typeof m.content === 'string' && (m.role === 'user' || m.role === 'assistant'))\n  .slice(-6)\n  .map((m) => ({ role: m.role, content: String(m.content).slice(0, 600) }));\n\nconst systemPrompt = \"You are the friendly virtual assistant for KQuality Cleaning Services, a commercial cleaning company based in Adelaide, South Australia. Services: office, commercial, medical, gym, school, retail, deep cleaning, end-of-lease, and Airbnb turnover cleaning. Hours: Mon-Fri 7am-6pm, Sat 8am-2pm, Sun emergency only (call 0439 489 630 for urgent jobs). Answer the visitor's question directly and specifically -- never repeat a generic greeting if they've already said something. Keep replies to 2-4 short sentences, warm, professional, Australian English. For firm pricing always point them to the 'Request a Quote' button so the team can tailor it -- never invent a specific dollar figure. Do not use <think> tags or show any reasoning -- respond with only the final answer.\";\n\nconst messages = [\n  { role: 'system', content: systemPrompt },\n  ...history,\n  { role: 'user', content: rawMessage || 'Hello' },\n];\n\nreturn [{ json: { messages, sessionId: String(body.sessionId || '') } }];"
      }
    },
    {
      "id": "b3621fba-ff20-418b-9887-0c5f3ebf1cd5",
      "name": "Call Qwen Model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.18.0.1:8080/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"messages\": $json.messages, \"temperature\": 0.6, \"max_tokens\": 180, \"stream\": false } }}",
        "options": {
          "timeout": 13000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "cd197a23-7e86-4852-8885-b0e749589180",
