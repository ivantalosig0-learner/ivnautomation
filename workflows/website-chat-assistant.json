        }
      }
    },
    {
      "id": "38bc7fdb-d5f3-401f-adaa-f586e62640ac",
      "name": "Extract Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nlet text = String((item.choices && item.choices[0] && item.choices[0].message && item.choices[0].message.content) || '').trim();\ntext = text.replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim();\nif (!text) {\n  text = \"Thanks for your question -- could you tell me a bit more, or use the Request a Quote button and our team will follow up directly?\";\n}\nreturn [{ json: { reply: text, mode: 'ai' } }];"
      }
    },
    {
      "id": "73c543b8-bec9-4ca5-b346-4864164f145a",
      "name": "Respond AI",
      "type": "n8n-nodes-base.respondToWebhook",
