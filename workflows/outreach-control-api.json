        "jsCode": "const b = $json.body || {};\nconst allowedKeys = ['automatic_outreach_enabled', 'qualification_threshold', 'daily_send_cap'];\nreturn { json: { token: String(b.token || ''), action: String(b.action || ''), setting_key: b.key != null ? String(b.key) : null, setting_value: b.value != null ? String(b.value) : null, key_allowed: b.key != null ? allowedKeys.includes(String(b.key)) : false, updated_by: String(b.updated_by || b.user || 'dashboard') } };"
      }
