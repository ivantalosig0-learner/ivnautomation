      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object('run_date', current_date, 'counts', (SELECT json_build_object('scheduled', count(*) FILTER (WHERE status='scheduled'), 'validated', count(*) FILTER (WHERE status='validated'), 'sent', count(*) FILTER (WHERE status='sent'), 'failed', count(*) FILTER (WHERE status='failed'), 'skipped', count(*) FILTER (WHERE status='skipped')) FROM leads.outreach_queue WHERE run_date = current_date), 'run', (SELECT row_to_json(r) FROM (SELECT status AS run_status, started_at, finished_at, abort_reason, sent_count, skipped_count, failed_count, threshold_used, cap_used FROM leads.outreach_runs WHERE run_date = current_date) r), 'items', (SELECT COALESCE(json_agg(q ORDER BY q.updated_at DESC), '[]'::json) FROM (SELECT candidate_id, business_name, qualification_score, status, reason, sent_at, email_generated, crm_updated, notification_created, updated_at FROM leads.outreach_queue WHERE run_date = current_date) q)) AS result",
        "options": {}
      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "jqlh240FlAgCW2po",
          "name": "Postgres account"
        }
