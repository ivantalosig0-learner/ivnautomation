      "onError": "continueRegularOutput"
    },
    {
      "id": "e524e851-e79e-47df-a9e2-a04a12930fdf",
      "name": "Assemble AI Enrichment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const prep = $('Prepare Analysis Request').item.json;\nconst pre = $('Prepare Opportunity Request').item.json;\nconst oppRes = $json;\nconst analysis = pre.analysis_response;\nconst o_ok = oppRes && oppRes.success === true && oppRes.data;\nconst ai = {\n  analyzed_at: new Date().toISOString(),\n  insufficient_text: prep.insufficient === true,\n  analysis: analysis ? analysis.data : null,\n  analysis_version: analysis ? analysis.prompt_version : null,\n  opportunities: o_ok ? oppRes.data : null,\n  opportunities_version: o_ok ? oppRes.prompt_version : null,\n  error: analysis ? null : 'website_analysis_failed'\n};\nreturn { json: { candidate_id: prep.candidate_id, payload: JSON.stringify({ ai }) } };"
      }
    },
    {
      "id": "699714ad-fa20-4561-85cf-75d9bb3db2ee",
