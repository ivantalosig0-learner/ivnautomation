      "parameters": {
        "method": "POST",
        "url": "http://ivnautomation-ai-gateway:8000/v1/ai/analysis/cleaning-opportunities",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.opp_request) }}",
        "options": {
