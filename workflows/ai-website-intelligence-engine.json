  "nodes": [
    {
      "id": "864cb021-f71a-47f5-9826-cc5b39677e22",
      "name": "Sticky Note f45411ac",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        896,
        336
      ],
      "parameters": {
        "content": "## AI Website Intelligence Engine v1\n\nEvery 2 hours: takes up to 15 crawled candidates without AI analysis (highest qualification first), sends stored website text to the AI Gateway (website_analysis_v1 + cleaning_opportunity_v1 / Qwen 3 8B), and writes results into enrichment.ai jsonb (business type, services, professionalism, cleaning opportunities, pitch priorities, confidence).\n\nAlways writes an ai key (even on failure) so candidates never loop forever. Deterministic crawling, email extraction and staging live in the Lead Intelligence Engine and are untouched.",
        "color": 6,
        "width": 1500,
        "height": 220
      }
    },
    {
      "id": "9198e373-6b72-4917-a7dd-76642cea957c",
      "name": "Every 2 Hours Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        192
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "127db44e-c591-468c-91b9-cd432f491c90",
      "name": "Fetch Analysis Queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        192
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.business_name, c.website, s.name AS segment_name, c.enrichment->'profile' AS profile FROM leads.candidates c LEFT JOIN leads.segments s ON s.id = c.segment_id WHERE c.duplicate_of IS NULL AND c.enrichment->'profile' IS NOT NULL AND c.enrichment->'ai' IS NULL ORDER BY c.qualification_score DESC NULLS LAST, c.id LIMIT 15"
      },
      "credentials": {
        "postgres": {
          "id": "jqlh240FlAgCW2po",
          "name": "Postgres account"
        }
      },
      "executeOnce": true
    },
    {
      "id": "9dae0494-b12a-4c28-8c0c-638f9ccaa49c",
      "name": "Analysis Complete",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "completedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      },
      "executeOnce": true
    },
    {
      "id": "e8239aad-bd87-4f5c-a565-f202c3f9f117",
      "name": "Prepare Analysis Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const r = $json;\nconst p = r.profile || {};\nconst parts = [];\nif (p.title) parts.push('PAGE TITLE: ' + p.title);\nif (p.description) parts.push('DESCRIPTION: ' + p.description);\nif (p.about_text) parts.push('ABOUT PAGE: ' + p.about_text);\nif (p.page_text) parts.push('HOMEPAGE TEXT: ' + p.page_text);\nconst website_text = parts.join('\\n').slice(0, 12000);\nreturn { json: {\n  candidate_id: r.id,\n  business_name: r.business_name,\n  website: r.website,\n  segment_name: r.segment_name || null,\n  insufficient: website_text.length < 20,\n  request: { url: r.website || null, website_text: website_text.length >= 20 ? website_text : 'no website text available for this business' }\n} };"
      }
    },
    {
      "id": "51919ec4-300d-477b-8084-9a92268b7414",
      "name": "AI Website Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        896,
        192
      ],
      "parameters": {
        "method": "POST",
        "url": "http://ivnautomation-ai-gateway:8000/v1/ai/website/analyze",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "8672effe-7274-4c60-984b-128e177fe404",
      "name": "Prepare Opportunity Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const prep = $('Prepare Analysis Request').item.json;\nconst res = $json;\nconst a_ok = res && res.success === true && res.data;\nreturn { json: {\n  analysis_response: a_ok ? res : null,\n  opp_request: {\n    business: {\n      name: prep.business_name,\n      industry: prep.segment_name,\n      website: prep.website,\n      description: (prep.request && prep.request.website_text ? prep.request.website_text.slice(0, 2000) : null)\n    },\n    website_analysis: a_ok ? res.data : null\n  }\n} };"
      }
    },
    {
      "id": "673e7679-4872-497e-ac5e-d0110344c593",
      "name": "AI Cleaning Opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1344,
        192
