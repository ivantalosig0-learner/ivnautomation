                "method": "POST",
                "options": {
                    "timeout": 15000,
                    "pagination": {
                        "pagination": {
                            "parameters": {
                                "parameters": [
                                    {
                                        "name": "pageToken",
                                        "type": "body",
                                        "value": "={{ $response.body.nextPageToken }}"
                                    }
                                ]
                            },
                            "maxRequests": 2,
                            "requestInterval": 800,
                            "limitPagesFetched": true,
                            "completeExpression": "={{ !$response.body.nextPageToken }}",
                            "paginationCompleteWhen": "other"
                        }
                    }
                },
                "jsonBody": "={{ (function(){ var zones = [[-34.9285,138.6007],[-34.759,138.642],[-35.133,138.501],[-34.918,138.735],[-34.848,138.493],[-34.596,138.744],[-35.066,138.856],[-35.018,138.518]]; var z = zones[($now.weekNumber * 3 + $now.day) % zones.length]; return { textQuery: $json.term, pageSize: 20, locationBias: { circle: { center: { latitude: z[0], longitude: z[1] }, radius: 40000.0 } } }; })() }}",
                "sendBody": true,
