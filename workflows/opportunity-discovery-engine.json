    {
      "id": "98601739-a45c-418b-b159-c8d21138f38c",
      "name": "Mark Duplicate Candidates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1104,
        144
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH matches AS (SELECT DISTINCT ON (d.id) d.id, o.id AS keep_id FROM leads.candidates d JOIN leads.candidates o ON o.id < d.id AND o.duplicate_of IS NULL AND lower(trim(d.business_name)) = lower(trim(o.business_name)) AND ((NULLIF(regexp_replace(COALESCE(d.phone, ''), '\\D', '', 'g'), '') IS NOT NULL AND regexp_replace(COALESCE(d.phone, ''), '\\D', '', 'g') = regexp_replace(COALESCE(o.phone, ''), '\\D', '', 'g')) OR (d.website IS NOT NULL AND lower(d.website) = lower(o.website))) WHERE d.duplicate_of IS NULL ORDER BY d.id, o.id), marked AS (UPDATE leads.candidates c SET duplicate_of = m.keep_id FROM matches m WHERE c.id = m.id RETURNING c.id) SELECT count(*) AS duplicates_marked FROM marked",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "jqlh240FlAgCW2po",
          "name": "Postgres account"
        }
      },
      "disabled": false,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "executeOnce": true
    },
