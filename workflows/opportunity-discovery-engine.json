        {
            "id": "bf3ff5ef-7819-4b41-81bd-7cf954c701a7",
            "name": "Sticky Note e88c5ed3",
            "type": "n8n-nodes-base.stickyNote",
            "position": [
                -112,
                -16
            ],
            "parameters": {
                "color": 4,
                "width": 1876,
                "height": 664,
                "content": "## Opportunity Discovery Engine v1\n\nDaily Google Places text search per enabled segment term (leads.segments.search_terms), deduped upsert into leads.candidates. Run tracking in leads.discovery_runs.\n\n**Credentials required:**\n1. IVNautomation Postgres — host: ivnautomation-postgres, db: ivnautomation, user: ivan\n2. Google Places API Key — httpHeaderAuth, header name: X-Goog-Api-Key"
            },
            "typeVersion": 1
        },
        {
            "id": "98601739-a45c-418b-b159-c8d21138f38c",
            "name": "Mark Duplicate Candidates",
            "type": "n8n-nodes-base.postgres",
            "disabled": false,
            "maxTries": 2,
            "position": [
                1104,
                144
            ],
            "parameters": {
                "query": "WITH p1 AS (\n  UPDATE leads.candidates c SET duplicate_of = g.keep_id FROM (\n    SELECT id, min(id) OVER (PARTITION BY leads.norm_email(email)) AS keep_id\n    FROM leads.candidates WHERE duplicate_of IS NULL AND email IS NOT NULL) g\n  WHERE c.id = g.id AND g.keep_id <> g.id RETURNING 1),\np2 AS (\n  UPDATE leads.candidates c SET duplicate_of = g.keep_id FROM (\n    SELECT id, min(id) OVER (PARTITION BY leads.norm_domain(website)) AS keep_id\n    FROM leads.candidates WHERE duplicate_of IS NULL\n      AND leads.norm_domain(website) IS NOT NULL) g\n  WHERE c.id = g.id AND g.keep_id <> g.id RETURNING 1),\np3 AS (\n  UPDATE leads.candidates c SET duplicate_of = g.keep_id FROM (\n    SELECT id, min(id) OVER (PARTITION BY leads.norm_phone(phone)) AS keep_id\n    FROM leads.candidates WHERE duplicate_of IS NULL\n      AND leads.norm_phone(phone) IS NOT NULL) g\n  WHERE c.id = g.id AND g.keep_id <> g.id RETURNING 1),\np4 AS (\n  UPDATE leads.candidates c SET duplicate_of = g.keep_id FROM (\n    SELECT id, min(id) OVER (PARTITION BY leads.norm_name(business_name),\n             lower(coalesce(suburb, split_part(address, ',', 2)))) AS keep_id\n    FROM leads.candidates WHERE duplicate_of IS NULL\n      AND leads.norm_name(business_name) IS NOT NULL) g\n  WHERE c.id = g.id AND g.keep_id <> g.id RETURNING 1),\np5 AS (\n  UPDATE leads.candidates SET excluded_from_outreach = true\n  WHERE duplicate_of IS NOT NULL AND excluded_from_outreach = false RETURNING 1),\np6 AS (\n  UPDATE leads.candidates SET do_not_contact = true, excluded_from_outreach = true,\n    stage = 'disqualified', stage_updated_at = now(),\n    qualification = qualification || jsonb_build_object('excluded_reason','cleaning_competitor')\n  WHERE do_not_contact = false\n    AND leads.is_cleaning_competitor(business_name, website, email) RETURNING 1)\nSELECT (SELECT count(*) FROM p1) + (SELECT count(*) FROM p2)\n     + (SELECT count(*) FROM p3) + (SELECT count(*) FROM p4) AS duplicates_marked,\n       (SELECT count(*) FROM p6) AS competitors_blocked",
                "options": {
                },
                "operation": "executeQuery"
            },
            "credentials": {
                "postgres": {
                    "id": "jqlh240FlAgCW2po",
                    "name": "Postgres account"
                }
            },
            "executeOnce": true,
            "retryOnFail": true,
            "typeVersion": 2.6,
            "waitBetweenTries": 2000
        },
