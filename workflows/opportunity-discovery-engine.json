        {
            "id": "c8ac1f39-45cd-4295-85e4-b43eaaefcbde",
            "name": "Upsert Candidate",
            "type": "n8n-nodes-base.postgres",
            "onError": "continueRegularOutput",
            "maxTries": 2,
            "position": [
                1552,
                400
            ],
            "parameters": {
                "query": "INSERT INTO leads.candidates (source_id, segment_id, external_ref, business_name,\n address, phone, website, latitude, longitude, raw, discovery_run_id)\nSELECT src.id, $1::smallint, $2, $3, $4, NULLIF($5,''), NULLIF($6,''),\n $7::numeric, $8::numeric, $9::jsonb, $10::bigint\nFROM leads.sources src WHERE src.code = 'google_places'\n  AND NOT leads.is_cleaning_competitor($3, NULLIF($6,''), NULL)\n  AND NOT EXISTS (SELECT 1 FROM leads.suppression s\n                  WHERE s.domain_norm IS NOT NULL\n                    AND s.domain_norm = leads.norm_domain(NULLIF($6,'')))\nON CONFLICT (source_id, external_ref) DO NOTHING",
                "options": {
                    "queryReplacement": "={{ [$json.segment_id, $json.external_ref, $json.business_name, $json.address, $json.phone, $json.website, $json.latitude, $json.longitude, $json.raw, $json.run_id] }}"
                },
                "operation": "executeQuery"
            },
