        {
            "id": "1011d022-19c4-4746-b175-223423457d72",
            "name": "Fetch Segment Search Terms",
            "type": "n8n-nodes-base.postgres",
            "position": [
                448,
                304
            ],
            "parameters": {
                "query": "WITH t AS (\n  SELECT s.id AS segment_id, s.code AS segment_code, e.term,\n         row_number() OVER (PARTITION BY s.id ORDER BY e.ord) AS term_idx,\n         s.priority_weight\n  FROM leads.segments s\n  CROSS JOIN LATERAL jsonb_array_elements_text(s.search_terms)\n       WITH ORDINALITY AS e(term, ord)\n  WHERE s.enabled\n), ordered AS (\n  SELECT segment_id, segment_code, term,\n         (row_number() OVER (ORDER BY term_idx, priority_weight DESC, segment_id) - 1) AS rn,\n         count(*) OVER () AS total\n  FROM t\n)\nSELECT segment_id, segment_code, term FROM ordered\nWHERE (rn / 65)\n      = (EXTRACT(doy FROM current_date)::int\n         % GREATEST(1, CEIL(total::numeric / 65)::int))\nORDER BY rn",
                "options": {
                },
                "operation": "executeQuery"
            },
            "credentials": {
                "postgres": {
                    "id": "jqlh240FlAgCW2po",
                    "name": "Postgres account"
                }
            },
            "executeOnce": true,
            "typeVersion": 2.6
        },
        {
            "id": "57afd3bc-8d6b-4aa5-a812-de7d76b2368f",
            "name": "Finalize Discovery Run",
            "type": "n8n-nodes-base.postgres",
            "position": [
                880,
                144
            ],
            "parameters": {
                "query": "UPDATE leads.discovery_runs SET\n  finished_at = now(),\n  status = 'succeeded',\n  candidates_new = (SELECT count(*) FROM leads.candidates c\n                    WHERE c.discovery_run_id = $1::bigint),\n  candidates_found = (SELECT count(*) FROM leads.candidates c\n                      WHERE c.discovery_run_id = $1::bigint)\nWHERE id = $1::bigint\nRETURNING id, status, candidates_new",
                "options": {
                    "queryReplacement": "={{ [$('Create Discovery Run').first().json.run_id] }}"
                },
                "operation": "executeQuery"
            },
            "credentials": {
                "postgres": {
                    "id": "jqlh240FlAgCW2po",
                    "name": "Postgres account"
                }
            },
            "executeOnce": true,
            "typeVersion": 2.6
        },
        {
