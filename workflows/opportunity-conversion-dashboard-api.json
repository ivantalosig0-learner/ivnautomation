      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT os.candidate_id, c.business_name, c.suburb, os.conversion_score, os.opportunity_health, os.next_best_action, os.next_best_action_reason, os.proposal_readiness, os.customer_readiness, os.conversion_probability, os.estimated_value, os.has_crm_record, os.is_customer, r.pipeline_stage\nFROM leads.opportunity_scores os\nJOIN leads.candidates c ON c.id = os.candidate_id\nLEFT JOIN leads.crm_records r ON r.candidate_id = os.candidate_id\nWHERE os.is_customer = false\nORDER BY os.conversion_score DESC\nLIMIT 20"
