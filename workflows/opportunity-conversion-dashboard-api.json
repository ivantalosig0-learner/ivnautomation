    {
      "id": "0bd43745-4450-48b4-9b99-56098215ed6c",
      "name": "Fetch Opportunity Detail",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        512
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT os.candidate_id, os.conversion_score, os.conversion_factors, os.opportunity_health, os.next_best_action, os.next_best_action_reason, os.proposal_readiness, os.customer_readiness, os.conversion_probability, os.estimated_value, os.has_crm_record, os.is_customer, os.scored_at,\n  r.pipeline_stage, r.last_contact_at, r.pipeline_stage_updated_at,\n  c.business_name, c.address, c.suburb, c.phone, c.website, c.email, c.qualification_score,\n  p.status AS proposal_status, p.sent_at AS proposal_sent_at, p.amount AS proposal_amount,\n  (SELECT json_agg(t) FROM (\n    SELECT event_type, event_at, summary, detail FROM leads.v_sales_timeline vt\n    WHERE vt.candidate_id = c.id ORDER BY vt.event_at DESC LIMIT 50\n  ) t) AS timeline\nFROM leads.opportunity_scores os\nJOIN leads.candidates c ON c.id = os.candidate_id\nLEFT JOIN leads.crm_records r ON r.candidate_id = os.candidate_id\nLEFT JOIN LATERAL (\n  SELECT status, sent_at, amount FROM leads.proposals pr WHERE pr.candidate_id = c.id ORDER BY created_at DESC LIMIT 1\n) p ON true\nWHERE os.candidate_id = $2 AND EXISTS (SELECT 1 FROM leads.dashboard_sessions WHERE token = $1 AND expires_at > now())",
        "options": {
          "queryReplacement": "={{ [ $json.token, $json.candidateId ] }}"
        }
